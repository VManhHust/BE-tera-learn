DATABASE_URL=jdbc:postgresql://localhost:5432/postgres?currentSchema=tera
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
APP_COOKIE_SECURE=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/callback/google

# Local: false sẽ in OTP vào console. Đổi thành true sau khi cấu hình SMTP.
MAIL_DELIVERY_ENABLED=false
MAIL_HEALTH_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=no-reply@tera.vn

EMAIL_VERIFICATION_SECRET=replace-with-a-different-random-secret-of-at-least-32-bytes

# SePay / Tera Plus
SEPAY_BANK=MBBank
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_HOLDER=
SEPAY_WEBHOOK_SECRET=replace-with-a-random-hmac-secret
PAYMENT_ORDER_EXPIRY_MINUTES=30
